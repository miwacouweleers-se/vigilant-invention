{
  "name": "vigilant-invention",
  "version": "1.0.0",
  "description": "Primary Inventory wireframe prototype (Doodle CSS)",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 3333",
    "start:py": "python3 -m http.server 3333",
    "serve": "npx --yes serve . -p 3333",
    "serve:prototype": "python3 -m http.server 3334",
    "open:prototype": "open http://localhost:3334/prototypes/create-new-inventory/index.html",
    "dev": "node scripts/serve-and-open.js",
    "serve:alt": "python3 -m http.server 5555",
    "open:alt": "open http://localhost:5555/prototypes/create-new-inventory/index.html"
  }
}
